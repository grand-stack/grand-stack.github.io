{
  "name": "grand-stack-github-io",
  "version": "0.1.3",
  "private": true,
  "license": "Apache-2.0",
  "description": "The GRANDstack website (grandstack.ai): a Hugo site with its own theme",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync": "node scripts/sync-docs.mjs",
    "sync:check": "node scripts/sync-docs.mjs --check",
    "dev": "hugo server",
    "build": "hugo --gc --minify",
    "check": "node scripts/check-site.mjs",
    "verify-examples": "node scripts/verify-examples.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "tags": "node scripts/latest-tags.mjs",
    "vendor": "node scripts/vendor-mixpanel.mjs",
    "test:browser": "node scripts/test-analytics-browser.mjs"
  },
  "devDependencies": {
    "mixpanel-browser": "2.84.0",
    "puppeteer-core": "25.15.0"
  }
}
